# NORMVAULT Root Environment Configuration

# Backend Settings
PROJECT_NAME="NORMVAULT Standards Intelligence Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL + pgvector)
# For production/Docker: postgresql+psycopg://normvault:normvault@localhost:5432/normvault
# For offline local dev fallback: sqlite:///./normvault_dev.db
DATABASE_URL="postgresql+psycopg://normvault:normvault@localhost:5432/normvault"

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]'

# LLM & Embedding Providers (Phase 1+)
# Providers: "openai", "gemini", "ollama", "huggingface"
LLM_PROVIDER="openai"
LLM_API_KEY=""
EMBEDDING_PROVIDER="openai"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Frontend Settings
VITE_API_BASE_URL="http://localhost:8000"
VITE_APP_TITLE="NORMVAULT | Standards Intelligence"
